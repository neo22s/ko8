{
  "name": "ko8/ko8",
  "description": "ko8 - the Koseven/Kohana 3.3 API on modern PHP. Lightweight HMVC, zero magic.",
  "license": "BSD-3-Clause",
  "keywords": [
    "kohana",
    "koseven",
    "ko8",
    "hmvc",
    "framework"
  ],
  "homepage": "https://github.com/neo22s/ko8",
  "authors": [
    {
      "name": "ko8 contributors"
    },
    {
      "name": "Koseven Team",
      "homepage": "https://koseven.dev/",
      "role": "developer"
    },
    {
      "name": "Kohana Team",
      "homepage": "http://kohanaframework.org/team",
      "role": "developer"
    }
  ],
  "support": {
    "issues": "https://github.com/neo22s/ko8/issues",
    "source": "https://github.com/neo22s/ko8"
  },
  "require": {
    "php": ">=8.1",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "rector/rector": "^2.8"
  },
  "replace": {
    "kohana/core": "3.3.*",
    "koseven/koseven": "3.3.*"
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "test:legacy": "phpunit -c phpunit.legacy.xml",
    "test:all": [
      "@test",
      "@test:legacy"
    ],
    "smoke": "php tools/smoke-test.php",
    "doctor": "php bin/ko8-doctor.php application",
    "check:guide": "php tools/check-guide-links.php",
    "lint": "find system modules application bin tools public -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
    "rector": "rector process --dry-run"
  }
}
